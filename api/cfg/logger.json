{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default_format": {
      "format": "%(asctime)s %(levelname)s | %(module)s %(funcName)s: %(message)s"
    }
  },

  "handlers": {
    "file": {
      "class": "logging.FileHandler",
      "level": "INFO",
      "formatter": "default_format",
      "filename": "app.log"
    }
  },

  "root": {
      "level": "INFO",
      "handlers": ["file"],
      "propagate": true
  }
}